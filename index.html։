<!DOCTYPE html>
<html lang="hy">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SMOKE X</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101010;color:white;font-family:Arial}
header{text-align:center;padding:25px;background:#191919;border-bottom:2px solid #e32636}
header h1{color:#e32636;letter-spacing:5px;font-size:36px}
main{max-width:1100px;margin:auto;padding:20px}
h2{text-align:center}
#products{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:18px}
.card{background:#202020;border-radius:14px;padding:14px}
.card img{width:100%;height:180px;object-fit:cover;border-radius:10px}
.price{color:#ff394b;font-size:22px;font-weight:bold}
button{background:#e32636;color:white;border:0;padding:12px;border-radius:8px}
footer{text-align:center;padding:25px;color:#888}
</style>
</head>
<body>
<header>
<h1>SMOKE X</h1>
<p>Բարի գալուստ մեր կայք</p>
</header>
<main>
<h2>Մեր ապրանքները</h2>
<div id="products">
<div class="card">
<img src="https://placehold.co/400x300?text=Product+1">
<h3>Ապրանք 1</h3>
<p>Ապրանքի նկարագրություն</p>
<div class="price">5 000 ֏</div>
</div>
<div class="card">
<img src="https://placehold.co/400x300?text=Product+2">
<h3>Ապրանք 2</h3>
<p>Ապրանքի նկարագրություն</p>
<div class="price">7 000 ֏</div>
</div>
</div>
</main>
<footer>SMOKE X © 2026</footer>
</body>
</html>
